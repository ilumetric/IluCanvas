{
  "name": "IluCanvas",
  "short_name": "IluCanvas",
  "description": "An infinite reference board in one local .ilucanvas file",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141516",
  "theme_color": "#141516",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-ilucanvas+zip": [".ilucanvas"],
        "application/x-pureref": [".pur"]
      },
      "launch_type": "single-client"
    }
  ]
}
