{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilumetric.github.io/IluCanvas/schema/canvas.schema.json",
  "title": "IluCanvas canvas.json",
  "description": "The scene inside a .ilucanvas file (a ZIP; see docs/FORMAT.md). Checks the shape; `node ilucanvas.mjs validate` also checks that ids are unique, that every image's asset exists, that parents are groups without cycles, and that asset files are in the ZIP. Unknown fields are allowed and kept.",
  "type": "object",
  "required": [
    "format",
    "version",
    "assets",
    "items"
  ],
  "properties": {
    "format": {
      "const": "ilucanvas"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "1. Readers keep fields they do not know."
    },
    "id": {
      "type": "string",
      "description": "The board's random id."
    },
    "title": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "enum": [
        "human",
        "agent"
      ],
      "description": "Who changed the board last: the app (human) or the CLI / window.ilucanvas (agent)."
    },
    "assets": {
      "type": "object",
      "description": "Image files by asset id (first 16 hex digits of the file's SHA-256 for new assets).",
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "items": {
      "type": "array",
      "description": "Everything on the board, in stacking order (later = on top). Groups are drawn below images, outer groups below inner ones.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/image"
          },
          {
            "$ref": "#/$defs/group"
          },
          {
            "$ref": "#/$defs/note"
          },
          {
            "$ref": "#/$defs/shape"
          },
          {
            "$ref": "#/$defs/connector"
          },
          {
            "$ref": "#/$defs/stroke"
          },
          {
            "$ref": "#/$defs/other"
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "box": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "description": "Left, board units (1 = 1 CSS px at 100%), before rotation."
        },
        "y": {
          "type": "number",
          "description": "Top, y down."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rot": {
          "type": "number",
          "description": "Degrees clockwise around the box centre; left out when 0."
        },
        "parent": {
          "$ref": "#/$defs/id",
          "description": "The group it belongs to."
        },
        "locked": {
          "const": true
        },
        "note": {
          "type": "string"
        }
      }
    },
    "image": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "asset"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "asset": {
          "$ref": "#/$defs/id"
        },
        "flipX": {
          "const": true
        },
        "flipY": {
          "const": true
        },
        "crop": {
          "type": "object",
          "description": "The visible part of the image, in the image's own pixels.",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "group": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "name",
        "color"
      ],
      "properties": {
        "type": {
          "const": "group"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "enum": [
            "violet",
            "blue",
            "orange",
            "green",
            "pink",
            "yellow",
            "red",
            "amber",
            "grey"
          ]
        }
      }
    },
    "other": {
      "description": "Item types from newer versions (video…): kept and drawn as a box.",
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "properties": {
        "type": {
          "not": {
            "enum": [
              "image",
              "group",
              "note",
              "shape",
              "connector",
              "stroke"
            ]
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^images/",
          "description": "Path inside the ZIP."
        },
        "type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            "image/bmp",
            "image/avif"
          ]
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "description": "Pixel width as displayed (EXIF rotation applied)."
        },
        "h": {
          "type": "number",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thumb": {
          "type": "string",
          "pattern": "^thumbs/",
          "description": "Preview ≤ 512 px (WebP); regenerated by the app when missing."
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$",
          "description": "Average colour."
        },
        "name": {
          "type": "string",
          "description": "Original file name."
        },
        "source": {
          "type": "string",
          "description": "Where it came from (URL)."
        },
        "added": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "note": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "text",
        "color"
      ],
      "properties": {
        "type": {
          "const": "note"
        },
        "text": {
          "type": "string",
          "description": "Markdown subset, every line one paragraph (docs/FORMAT.md)."
        },
        "color": {
          "enum": [
            "yellow",
            "orange",
            "pink",
            "green",
            "blue",
            "violet",
            "grey",
            "paper",
            "none"
          ]
        },
        "fit": {
          "const": true,
          "description": "Text grows / shrinks to fill the card (stickies)."
        },
        "size": {
          "enum": [
            "s",
            "l",
            "xl"
          ],
          "description": "Text size; m when left out."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "enum": [
            "center",
            "right"
          ]
        },
        "ratio": {
          "enum": [
            "square",
            "a4",
            "wide"
          ]
        }
      }
    },
    "shape": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "kind",
        "fill",
        "text"
      ],
      "properties": {
        "type": {
          "const": "shape"
        },
        "kind": {
          "enum": [
            "rect",
            "rounded",
            "ellipse",
            "diamond",
            "triangle",
            "parallelogram",
            "hexagon",
            "star"
          ]
        },
        "fill": {
          "enum": [
            "white",
            "grey",
            "black",
            "red",
            "orange",
            "yellow",
            "green",
            "blue",
            "violet",
            "pink",
            "none"
          ],
          "description": "Fixed colours; none = only the outline."
        },
        "stroke": {
          "enum": [
            "white",
            "grey",
            "black",
            "red",
            "orange",
            "yellow",
            "green",
            "blue",
            "violet",
            "pink"
          ],
          "description": "Outline colour; no outline when left out (grey for fill none)."
        },
        "text": {
          "type": "string",
          "description": "Markdown, like notes; centred. The shape grows downwards to show all of it."
        },
        "size": {
          "enum": [
            "s",
            "l",
            "xl"
          ],
          "description": "Text size; m when left out."
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "enum": [
            "left",
            "right"
          ],
          "description": "center when left out."
        }
      }
    },
    "end": {
      "description": "A connector end: on an item (id, optionally pinned to a side) or a free point on the board.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "side": {
              "enum": [
                "top",
                "right",
                "bottom",
                "left"
              ],
              "description": "Left out: the side facing the other end, chosen as things move."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      ]
    },
    "connector": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "from",
        "to",
        "end",
        "color"
      ],
      "description": "A line or arrow between two ends. x, y, w, h are its bounds, kept up to date by the tools (not a place to edit).",
      "properties": {
        "type": {
          "const": "connector"
        },
        "from": {
          "$ref": "#/$defs/end"
        },
        "to": {
          "$ref": "#/$defs/end"
        },
        "route": {
          "enum": [
            "elbow",
            "curve",
            "dubins"
          ],
          "description": "straight when left out; the tools make Dubins paths by default."
        },
        "start": {
          "enum": [
            "arrow",
            "dot"
          ],
          "description": "Head at the from end; none when left out."
        },
        "end": {
          "enum": [
            "none",
            "arrow",
            "dot"
          ],
          "description": "Head at the to end."
        },
        "color": {
          "enum": [
            "white",
            "grey",
            "black",
            "red",
            "orange",
            "yellow",
            "green",
            "blue",
            "violet",
            "pink"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Line width in board units; 2 when left out."
        },
        "dash": {
          "const": true
        },
        "label": {
          "type": "string",
          "description": "Text in the middle of the line."
        }
      }
    },
    "stroke": {
      "allOf": [
        {
          "$ref": "#/$defs/box"
        }
      ],
      "required": [
        "tool",
        "color",
        "width",
        "pts"
      ],
      "description": "Freehand ink. pts are measured in a vw × vh box and drawn stretched into x, y, w, h.",
      "properties": {
        "type": {
          "const": "stroke"
        },
        "tool": {
          "enum": [
            "pen",
            "highlighter",
            "tape"
          ]
        },
        "nib": {
          "const": "italic",
          "description": "Pens only; round when left out."
        },
        "color": {
          "anyOf": [
            {
              "enum": [
                "white",
                "grey",
                "black",
                "red",
                "orange",
                "yellow",
                "green",
                "blue",
                "violet",
                "pink"
              ]
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          ],
          "description": "A palette name or a custom #rrggbb."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Line width in the stroke's own units."
        },
        "vw": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Width of the box pts are measured in (w when left out)."
        },
        "vh": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pts": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Flat samples: x, y, pressure (0…1), x, y, pressure, …"
        },
        "tw": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Stylus barrel rotation per sample, degrees."
        }
      }
    }
  }
}
