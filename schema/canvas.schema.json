{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilumetric.github.io/IluCanvas/schema/canvas.schema.json",
  "title": "IluCanvas canvas.json",
  "description": "The scene inside a .ilucanvas file (a ZIP; see docs/FORMAT.md). Checks the shape; `node ilucanvas.mjs validate` also checks that ids are unique, that every image's asset exists, that parents are groups without cycles, and that asset files are in the ZIP. Unknown fields are allowed and kept.",
  "type": "object",
  "required": ["format", "version", "assets", "items"],
  "properties": {
    "format": { "const": "ilucanvas" },
    "version": { "type": "integer", "minimum": 1, "description": "1. Readers keep fields they do not know." },
    "id": { "type": "string", "description": "The board's random id." },
    "title": { "type": "string" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "updated_by": { "enum": ["human", "agent"], "description": "Who changed the board last: the app (human) or the CLI / window.ilucanvas (agent)." },
    "assets": {
      "type": "object",
      "description": "Image files by asset id (first 16 hex digits of the file's SHA-256 for new assets).",
      "additionalProperties": { "$ref": "#/$defs/asset" }
    },
    "items": {
      "type": "array",
      "description": "Everything on the board, in stacking order (later = on top). Groups are drawn below images, outer groups below inner ones.",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/image" }, { "$ref": "#/$defs/group" }, { "$ref": "#/$defs/other" }]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "box": {
      "type": "object",
      "required": ["id", "type", "x", "y", "w", "h"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "x": { "type": "number", "description": "Left, board units (1 = 1 CSS px at 100%), before rotation." },
        "y": { "type": "number", "description": "Top, y down." },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "rot": { "type": "number", "description": "Degrees clockwise around the box centre; left out when 0." },
        "parent": { "$ref": "#/$defs/id", "description": "The group it belongs to." },
        "locked": { "const": true },
        "note": { "type": "string" }
      }
    },
    "image": {
      "allOf": [{ "$ref": "#/$defs/box" }],
      "required": ["asset"],
      "properties": {
        "type": { "const": "image" },
        "asset": { "$ref": "#/$defs/id" },
        "flipX": { "const": true },
        "flipY": { "const": true },
        "crop": {
          "type": "object",
          "description": "The visible part of the image, in the image's own pixels.",
          "required": ["x", "y", "w", "h"],
          "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "opacity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
      }
    },
    "group": {
      "allOf": [{ "$ref": "#/$defs/box" }],
      "required": ["name", "color"],
      "properties": {
        "type": { "const": "group" },
        "name": { "type": "string" },
        "color": { "enum": ["violet", "blue", "orange", "green", "pink", "yellow", "red", "amber", "grey"] }
      }
    },
    "other": {
      "description": "Item types from newer versions (note, stroke, widget…): kept and drawn as a box.",
      "allOf": [{ "$ref": "#/$defs/box" }],
      "properties": { "type": { "not": { "enum": ["image", "group"] } } }
    },
    "asset": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "pattern": "^images/", "description": "Path inside the ZIP." },
        "type": { "enum": ["image/jpeg", "image/png", "image/webp", "image/gif", "image/bmp", "image/avif"] },
        "w": { "type": "number", "minimum": 0, "description": "Pixel width as displayed (EXIF rotation applied)." },
        "h": { "type": "number", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "thumb": { "type": "string", "pattern": "^thumbs/", "description": "Preview ≤ 512 px (WebP); regenerated by the app when missing." },
        "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$", "description": "Average colour." },
        "name": { "type": "string", "description": "Original file name." },
        "source": { "type": "string", "description": "Where it came from (URL)." },
        "added": { "type": "string", "format": "date-time" }
      }
    }
  }
}
